#!/bin/bash
# tkt — tikeytaka 코어 CLI v2. API 키 정본 볼트(암호화 파일) + 프로젝트 .env 전파.
# 정본: 클라우드 동기화 폴더의 secrets.enc (AES-256-CBC + PBKDF2, TKT2 포맷·무결성 해시 내장).
# 복호화 암호: OS 기본 비밀 저장소(맥 키체인 / Linux secret-tool / Windows DPAPI / 명시적 파일 폴백).
#
# 사용법:
#   tkt init                  새 기기 셋업 (볼트 암호 등록; 최초 기기는 자동 생성)
#   tkt set <service> <값>    키 등록/갱신 (주의: 값이 셸 히스토리·ps에 남을 수 있음)
#   tkt set-stdin <service>   키 등록 — stdin으로 값 수신 (자동화·스킬용 권장 경로)
#   tkt setp <service>        키 등록 (터미널 숨김 입력 — 채팅/히스토리 유출 방지)
#   tkt get <service>         값 조회
#   tkt del <service>         삭제
#   tkt list                  서비스 목록
#   tkt map-add <파일> <변수> <service>   프로젝트 .env 연결 추가
#   tkt map-list              연결 목록
#   tkt sync [--check]        볼트 → 연결된 모든 .env 전파 (--check는 드라이런)
#   tkt where                 볼트/매핑 파일 위치 출력
set -euo pipefail
umask 077

ACCT="${USER:-tikeytaka}"
CONF_DIR="$HOME/.config/tikeytaka"
MAP="$CONF_DIR/map.tsv"
VAULT_PATH_FILE="$CONF_DIR/vault.path"
mkdir -p "$CONF_DIR"

# 암호화 파라미터 — 맥(LibreSSL)·리눅스(OpenSSL 3) 동일 옵션 명시 (기본값 의존 금지)
OPENSSL_ARGS=(-aes-256-cbc -salt -pbkdf2 -iter 600000 -md sha256)

die() { echo "tkt: $*" >&2; exit 1; }
sha256() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'; else sha256sum | awk '{print $1}'; fi; }

TMPFILES=()
cleanup() { local f; for f in ${TMPFILES[@]+"${TMPFILES[@]}"}; do rm -f "$f"; done; }
trap cleanup EXIT
mktmp() { local t; t="$(mktemp "${1:-${TMPDIR:-/tmp}}/tkt.XXXXXX")"; TMPFILES+=("$t"); printf '%s' "$t"; }

# ---------- 입력 검증 (쓰기 전에 거부 — 정규식 오작동·TSV 주입 차단) ----------
validate_service() {
  [ -n "$1" ] || die "서비스명이 비어 있음"
  case "$1" in
    [!A-Za-z0-9]*) die "서비스명은 영숫자로 시작: '$1'";;
    *[!A-Za-z0-9._-]*) die "서비스명에 허용되지 않는 문자 (A-Za-z0-9._- 만): '$1'";;
  esac
}
validate_var() {
  case "$1" in
    [!A-Za-z_]*|"") die "변수명 형식 오류 ([A-Za-z_][A-Za-z0-9_]*): '$1'";;
    *[!A-Za-z0-9_]*) die "변수명 형식 오류 ([A-Za-z_][A-Za-z0-9_]*): '$1'";;
  esac
}
validate_value() {
  [ -n "$1" ] || die "빈 값"
  case "$1" in *[[:space:]]*) die "값에 공백/탭/개행 불가 (v2 제약 — 단일행 토큰만)";; esac
  case "$1" in *\"*|*\'*) die "값에 따옴표 불가 (v2 제약)";; esac
}
validate_path() { case "$1" in *[$'\t\r\n']*) die "경로에 탭/개행 불가";; "") die "빈 경로";; esac; }

# ---------- 볼트 위치: 최초 선택을 vault.path에 고정 (실행마다 널뛰기 방지) ----------
detect_cloud_dir() {
  local c
  c="$HOME/Library/Mobile Documents/com~apple~CloudDocs"; [ -d "$c" ] && { echo "$c/tikeytaka"; return; }
  for c in "$HOME/Library/CloudStorage"/GoogleDrive-*/"My Drive" "$HOME/Google Drive/My Drive" \
           "$HOME/iCloudDrive" "/g/My Drive" "$HOME/OneDrive"* "$HOME/Dropbox" \
           /mnt/c/Users/*/OneDrive* "/mnt/c/Users"/*/iCloudDrive "/mnt/g/My Drive"; do
    [ -d "$c" ] && { echo "$c/tikeytaka"; return; }
  done
  echo "$HOME/.tikeytaka"   # 동기화 폴더 없음 — 단일 기기 모드
}
vault_dir() {
  if [ -n "${TIKEYTAKA_DIR:-}" ]; then echo "$TIKEYTAKA_DIR"; return; fi   # 명시적 override
  if [ -f "$VAULT_PATH_FILE" ]; then cat "$VAULT_PATH_FILE"; return; fi     # 고정된 경로
  detect_cloud_dir
}
pin_vault_dir() {  # init에서만 호출 — 경로 확정
  [ -n "${TIKEYTAKA_DIR:-}" ] && return 0
  [ -f "$VAULT_PATH_FILE" ] && return 0
  vault_dir > "$VAULT_PATH_FILE"
}
VAULT="$(vault_dir)/secrets.enc"

# ---------- 복호화 암호 저장소 (OS별; 저장소 간 자동 폴백 없음 — 명시성 우선) ----------
win_path() {
  if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"       # Git Bash/MSYS
  elif command -v wslpath >/dev/null 2>&1; then wslpath -w "$1"     # WSL
  else printf '%s' "$1"; fi
}
pass_get() {
  if [ -n "${TKT_PASSPHRASE_FILE:-}" ]; then cat "$TKT_PASSPHRASE_FILE" 2>/dev/null; return; fi
  if command -v security >/dev/null 2>&1; then
    security find-generic-password -s tikeytaka-passphrase -w 2>/dev/null; return
  fi
  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup service tikeytaka 2>/dev/null; return
  fi
  if command -v powershell.exe >/dev/null 2>&1; then
    [ -f "$CONF_DIR/passphrase.dpapi" ] || return 1
    powershell.exe -NoProfile -Command "\$s = Get-Content -Raw '$(win_path "$CONF_DIR/passphrase.dpapi")' | ConvertTo-SecureString; [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR(\$s))" 2>/dev/null | tr -d '\r'
    return
  fi
  [ -f "$CONF_DIR/passphrase" ] && { cat "$CONF_DIR/passphrase"; return; }
  return 1
}
pass_set() {
  if [ -n "${TKT_PASSPHRASE_FILE:-}" ]; then printf '%s' "$1" > "$TKT_PASSPHRASE_FILE"; chmod 600 "$TKT_PASSPHRASE_FILE"; return; fi
  if command -v security >/dev/null 2>&1; then
    security add-generic-password -U -s tikeytaka-passphrase -a "$ACCT" -w "$1"; return
    # 알려진 한계: security -w는 argv 경유(1회성). stdin 경로 부재는 도구 제약.
  fi
  if command -v secret-tool >/dev/null 2>&1; then
    printf '%s' "$1" | secret-tool store --label=tikeytaka service tikeytaka; return
  fi
  if command -v powershell.exe >/dev/null 2>&1; then
    TKT_P="$1" powershell.exe -NoProfile -Command "ConvertTo-SecureString -String \$env:TKT_P -AsPlainText -Force | ConvertFrom-SecureString | Set-Content -Path '$(win_path "$CONF_DIR/passphrase.dpapi")'"; return
  fi
  [ "${TKT_ALLOW_FILE_FALLBACK:-}" = "1" ] || die "OS 비밀 저장소가 없습니다. 평문 파일 폴백을 쓰려면 TKT_ALLOW_FILE_FALLBACK=1 로 재실행하세요 (보안 저하 — 볼트 암호가 파일로 저장됨)."
  printf '%s' "$1" > "$CONF_DIR/passphrase"; chmod 600 "$CONF_DIR/passphrase"
  echo "주의: 볼트 암호를 $CONF_DIR/passphrase (0600) 파일에 저장했습니다. OS 비밀 저장소보다 약합니다." >&2
}
load_pass() {
  PASS="$(pass_get)" && [ -n "$PASS" ] || die "볼트 암호 미등록 — 'tkt init' 먼저 실행하세요."
}

# ---------- 암복호화 (파일 단위 — 스트리밍 파이프라인 금지, 암호는 stdin 전달) ----------
enc_file() { printf '%s\n' "$PASS" | openssl enc "${OPENSSL_ARGS[@]}" -pass stdin -in "$1" -out "$2" 2>/dev/null; }
dec_file() { printf '%s\n' "$PASS" | openssl enc -d "${OPENSSL_ARGS[@]}" -pass stdin -in "$1" -out "$2" 2>/dev/null; }

# ---------- TKT2 평문 포맷: #TKT2 / #SHA256:<본문해시> / TSV 본문 ----------
write_plain() { { echo "#TKT2"; echo "#SHA256:$(sha256 < "$1")"; cat "$1"; } > "$2"; }
validate_plain() {
  local h
  [ "$(head -1 "$1" 2>/dev/null)" = "#TKT2" ] || return 1
  h="$(sed -n '2p' "$1")"; case "$h" in "#SHA256:"*) ;; *) return 1;; esac
  [ "${h#\#SHA256:}" = "$(tail -n +3 "$1" | sha256)" ] || return 1
  if tail -n +3 "$1" | LC_ALL=C grep -qEv $'^[A-Za-z0-9][A-Za-z0-9._-]*\t[^\t]+$'; then return 1; fi
  return 0
}
vault_read_to() {  # $1: 평문 out. 실패 시 원본 무손상 중단.
  dec_file "$VAULT" "$1" || die "볼트 복호화 실패 — 암호 불일치 또는 파일 손상. 원본($VAULT)은 변경되지 않았습니다."
  validate_plain "$1" || die "볼트 무결성 검증 실패(TKT2 포맷/해시 불일치) — 동기화 미완료·손상 가능. 원본은 변경되지 않았습니다."
}
vault_body_to() { local p; p="$(mktmp)"; vault_read_to "$p"; tail -n +3 "$p" > "$1"; }
vault_commit() {  # $1: 새 body 파일, $2: 편집 시작 시점의 암호문 해시('':신규)
  local dir plain cipher verify
  dir="$(dirname "$VAULT")"; mkdir -p "$dir"
  plain="$(mktmp)"; write_plain "$1" "$plain"
  cipher="$(mktmp "$dir")"
  enc_file "$plain" "$cipher" || die "암호화 실패"
  verify="$(mktmp)"
  dec_file "$cipher" "$verify" || die "자가검증 복호화 실패 — 커밋 중단"
  cmp -s "$plain" "$verify" || die "라운드트립 검증 실패 — 커밋 중단"
  if [ -f "$VAULT" ]; then
    [ -n "$2" ] || die "내부 오류: 기존 볼트가 있는데 원본 해시가 없음"
    [ "$(sha256 < "$VAULT")" = "$2" ] || die "편집 도중 볼트가 외부에서 변경됨(다른 기기 동기화?) — 중단. 다시 시도하세요."
    cp -p "$VAULT" "$VAULT.bak"
  fi
  mv "$cipher" "$VAULT"
}

# ---------- 항목 편집 (정확 필드 비교 — 정규식 미사용) ----------
vault_set_entry() {  # $1 svc, $2 val
  validate_service "$1"; validate_value "$2"
  load_pass
  local body orig="" line
  body="$(mktmp)"
  if [ -f "$VAULT" ]; then
    local cur; cur="$(mktmp)"
    orig="$(sha256 < "$VAULT")"
    vault_body_to "$cur"
    while IFS= read -r line; do
      [ "${line%%$'\t'*}" = "$1" ] || printf '%s\n' "$line"
    done < "$cur" > "$body"
  fi
  printf '%s\t%s\n' "$1" "$2" >> "$body"
  sort -o "$body" "$body"
  vault_commit "$body" "$orig"
  echo "set: $1"
}

read_tty_secret() {  # $1 프롬프트 → 전역 REPLY_SECRET
  [ -r /dev/tty ] && [ -w /dev/tty ] || die "터미널이 필요합니다 — 별도 터미널에서 직접 실행하세요."
  printf '%s' "$1" > /dev/tty
  IFS= read -rs REPLY_SECRET < /dev/tty
  printf '\n' > /dev/tty
}

cmd="${1:-help}"
case "$cmd" in
  init)
    if PASS="$(pass_get)" && [ -n "$PASS" ]; then
      if [ -f "$VAULT" ]; then
        tmp="$(mktmp)"
        if dec_file "$VAULT" "$tmp" && validate_plain "$tmp"; then
          pin_vault_dir; echo "이미 셋업됨. 볼트: $VAULT"; exit 0
        fi
        echo "저장된 암호로 현재 볼트를 열 수 없습니다 (다른 볼트/손상). 올바른 암호를 입력하세요." >&2
        read_tty_secret "볼트 암호: "
        PASS="$REPLY_SECRET"
        dec_file "$VAULT" "$tmp" && validate_plain "$tmp" || die "암호가 볼트와 맞지 않습니다. (기존 저장 암호는 변경하지 않음)"
        pass_set "$PASS"; pin_vault_dir; echo "셋업 완료(암호 갱신). 볼트: $VAULT"; exit 0
      fi
      # 암호는 있는데 볼트 없음 → 빈 v2 볼트 실제 생성
      body="$(mktmp)"; vault_commit "$body" ""
      pin_vault_dir; echo "셋업 완료 — 빈 볼트 생성: $VAULT"; exit 0
    fi
    if [ -f "$VAULT" ]; then
      read_tty_secret "기존 볼트 발견. 다른 기기와 동일한 암호 입력: "
      PASS="$REPLY_SECRET"
      tmp="$(mktmp)"
      dec_file "$VAULT" "$tmp" && validate_plain "$tmp" || die "암호가 볼트와 맞지 않습니다. (아무것도 저장하지 않음)"
      pass_set "$PASS"; pin_vault_dir; echo "셋업 완료. 볼트: $VAULT"
    else
      PASS="$(openssl rand -base64 32)"
      body="$(mktmp)"; vault_commit "$body" ""
      pass_set "$PASS"; pin_vault_dir
      echo "새 볼트 생성 완료: $VAULT"
      if [ -w /dev/tty ]; then
        { echo "⚠️  다른 기기 연결 시 필요합니다. 아래 암호를 암호 관리자에 보관하세요:"; echo "$PASS"; } > /dev/tty
      else
        echo "⚠️  볼트 암호가 생성되어 OS 저장소에 등록됐습니다. 다른 기기 연결 전에 터미널에서 'tkt init'을 실행해 암호를 확인·보관하세요." >&2
      fi
    fi ;;
  set)
    [ $# -eq 3 ] || die "usage: tkt set <service> <value>"
    vault_set_entry "$2" "$3" ;;
  set-stdin)
    [ $# -eq 2 ] || die "usage: printf '%s' \"\$VALUE\" | tkt set-stdin <service>"
    IFS= read -r v || [ -n "${v:-}" ] || die "stdin에서 값을 읽지 못했습니다"
    vault_set_entry "$2" "$v" ;;
  setp)
    [ $# -eq 2 ] || die "usage: tkt setp <service>"
    read_tty_secret "$2 값 입력(화면에 안 보임): "
    vault_set_entry "$2" "$REPLY_SECRET" ;;
  get)
    [ $# -eq 2 ] || die "usage: tkt get <service>"
    validate_service "$2"; load_pass
    [ -f "$VAULT" ] || die "볼트 없음 — tkt init 먼저"
    body="$(mktmp)"; vault_body_to "$body"
    v=""
    while IFS= read -r line; do
      [ "${line%%$'\t'*}" = "$2" ] && { v="${line#*$'\t'}"; break; }
    done < "$body"
    [ -n "$v" ] || die "없음: $2"
    printf '%s\n' "$v" ;;
  del)
    [ $# -eq 2 ] || die "usage: tkt del <service>"
    validate_service "$2"; load_pass
    [ -f "$VAULT" ] || die "볼트 없음"
    orig="$(sha256 < "$VAULT")"
    cur="$(mktmp)"; vault_body_to "$cur"
    body="$(mktmp)"; found=0
    while IFS= read -r line; do
      if [ "${line%%$'\t'*}" = "$2" ]; then found=1; else printf '%s\n' "$line"; fi
    done < "$cur" > "$body"
    [ "$found" = 1 ] || die "없음: $2"
    vault_commit "$body" "$orig"
    echo "del: $2" ;;
  list)
    load_pass
    [ -f "$VAULT" ] || { echo "(볼트 없음 — tkt init 먼저)" >&2; exit 2; }
    body="$(mktmp)"; vault_body_to "$body"
    cut -f1 < "$body" ;;
  map-add)
    [ $# -eq 4 ] || die "usage: tkt map-add <파일> <변수> <service>"
    validate_path "$2"; validate_var "$3"; validate_service "$4"
    touch "$MAP"
    grep -qF "$2	$3	" "$MAP" 2>/dev/null && { echo "이미 연결됨: $2 :: $3"; exit 0; }
    printf '%s\t%s\t%s\n' "$2" "$3" "$4" >> "$MAP"
    echo "연결 추가: $2 :: $3 ← $4" ;;
  map-list)
    if [ ! -f "$MAP" ] || [ ! -s "$MAP" ]; then echo "연결 없음"
    elif command -v column >/dev/null 2>&1; then column -t -s $'\t' "$MAP"
    else cat "$MAP"; fi ;;
  sync)
    check="${2:-}"
    { [ -z "$check" ] || [ "$check" = "--check" ]; } || die "usage: tkt sync [--check]"
    [ $# -le 2 ] || die "usage: tkt sync [--check]"
    load_pass
    [ -f "$MAP" ] && [ -s "$MAP" ] || { echo "연결 없음 — tkt map-add 먼저"; exit 0; }
    [ -f "$VAULT" ] || die "볼트 없음 — tkt init/set 먼저"
    snap="$(mktmp)"; vault_body_to "$snap"    # 스냅샷 1회 복호화 — 매핑마다 재복호화 금지
    changed=0; errors=0
    while IFS=$'\t' read -r file var svc; do
      [ -z "$file" ] && continue; case "$file" in \#*) continue;; esac
      f="${file/#\~/$HOME}"
      [ -f "$f" ] || { echo "skip (파일 없음): $f"; errors=$((errors+1)); continue; }
      val=""
      while IFS= read -r line; do
        [ "${line%%$'\t'*}" = "$svc" ] && { val="${line#*$'\t'}"; break; }
      done < "$snap"
      [ -n "$val" ] || { echo "skip (볼트에 없음): $svc"; errors=$((errors+1)); continue; }
      cur=""; found=0; dup=0
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
          "$var="*) if [ "$found" = 0 ]; then cur="${line#*=}"; found=1; else dup=1; fi ;;
        esac
      done < "$f"
      case "$cur" in \"*\") cur="${cur#\"}"; cur="${cur%\"}";; \'*\') cur="${cur#\'}"; cur="${cur%\'}";; esac
      if [ "$found" = 1 ] && [ "$cur" = "$val" ] && [ "$dup" = 0 ]; then continue; fi
      changed=$((changed+1))
      if [ "$check" = "--check" ]; then echo "would update: $f :: $var"; continue; fi
      perms="$(stat -f %Lp "$f" 2>/dev/null || stat -c %a "$f" 2>/dev/null || echo 600)"
      tmp="$(mktmp "$(dirname "$f")")"
      done_one=0
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
          "$var="*) if [ "$done_one" = 0 ]; then printf '%s=%s\n' "$var" "$val"; done_one=1; fi ;;  # 중복 정의는 첫 줄로 정규화
          *) printf '%s\n' "$line" ;;
        esac
      done < "$f" > "$tmp"
      [ "$done_one" = 1 ] || printf '%s=%s\n' "$var" "$val" >> "$tmp"
      chmod "$perms" "$tmp"    # 원본 권한 보존 (0600 → 0600)
      mv "$tmp" "$f"
      echo "updated: $f :: $var"
    done < "$MAP"
    echo "sync 완료 (${changed}건 변경, ${errors}건 skip)"
    [ "$errors" = 0 ] || exit 3 ;;
  where)
    echo "볼트: $VAULT"
    [ -f "$VAULT_PATH_FILE" ] && echo "경로 고정: $(cat "$VAULT_PATH_FILE")" || echo "경로 고정: (아직 — init에서 확정)"
    echo "매핑: $MAP" ;;
  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed -n '2,17p' ;;
esac
